# 빌드 환경변수 (Cloudflare Pages > Settings > Environment variables, 또는 로컬 .env)
# 실제 값은 커밋하지 않는다.

# 운영 도메인(끝에 / 없이). canonical, og:url, sitemap.xml, robots.txt, 결과 복사 URL에 사용.
SITE_URL=https://example.pages.dev
# 푸터·정책 페이지 문의 메일
CONTACT_EMAIL=
# Gumroad 상품 URL (예: https://<seller>.gumroad.com/l/<permalink>). 없으면 구매 버튼 비활성화 + 빌드 경고
VITE_GUMROAD_URL=
# 분석: 둘 중 하나 이상. 없으면 track()은 no-op
# GA4 측정 ID (예: G-XXXXXXXXXX) — calc_complete, checkout_click 같은 맞춤 이벤트는 GA4에서만 기록됨
VITE_GA4_ID=
# Cloudflare Web Analytics 토큰 — page_view만(맞춤 이벤트 미지원)
VITE_CF_BEACON_TOKEN=

# ---- Pages Functions 런타임 (Settings > Variables and Secrets, Secret으로 등록) ----
# GUMROAD_SELLER_ID=   Gumroad Ping의 seller_id와 대조
# GUMROAD_PING_TOKEN=  Ping URL의 ?token= 값과 대조(권장, 긴 무작위 문자열)
# KV 바인딩: SALES (Settings > Bindings > KV namespace)
